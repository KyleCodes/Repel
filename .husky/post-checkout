#!/usr/bin/env bash
set -e
# $3=1 branch switch, $3=0 file checkout. Skip file checkouts.
[ "$3" = "1" ] || exit 0
cd "$(git rev-parse --show-toplevel)"
bun install
bun run clean
# Re-warm the Nx graph + build cache for the newly checked-out branch.
# Non-blocking: a build failure must not abort the checkout.
bunx nx run-many -t build || true
