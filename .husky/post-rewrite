#!/usr/bin/env bash
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
bun install
bun run clean
# Re-warm the Nx graph + build cache after the rewrite (rebase/amend).
# Non-blocking: a build failure must not abort the rebase.
bunx nx run-many -t build || true

# DB reset prompt on rebase (not amend). Disable with DEVCTL_DB_PROMPT=0.
# Skipped when stdin isn't a tty. --force drops the per-branch db and
# re-clones from template; any unmigrated local rows are lost.
if [ "$1" = "rebase" ] && [ "${DEVCTL_DB_PROMPT:-1}" != "0" ] && [ -t 0 ]; then
  branch="$(git rev-parse --abbrev-ref HEAD)"
  printf "devctl: reset db for '%s' from template? (drops current db) [y/N] " "$branch" > /dev/tty
  read -r reply < /dev/tty
  if [ "$reply" = "y" ] || [ "$reply" = "Y" ]; then
    # Post-REP-61 paths: CLI is @repel/backend-cli (entry src/index.ts); the
    # worktree env file lives at packages/backend/.env.local.
    ( cd "$ROOT/packages/backend/apps/cli" && PG_ADMIN_URL="postgres://repel:dev@localhost:5432/postgres" \
      bun run src/index.ts db clone "$branch" --force --env-file "$ROOT/packages/backend/.env.local" )
  fi
fi
