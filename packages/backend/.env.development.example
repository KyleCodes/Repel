# Shared development environment template.
#
# Copy to .env.development (gitignored) and fill in real values. .env.development
# is symlinked into each worktree and distributed privately between developers —
# never commit it. Per-worktree, ephemeral values (DATABASE_URL) live in
# .env.local, written by `repel db clone`, NOT here.

MODE=all

# 32-byte AES-256-GCM key for credential encryption at rest, hex-encoded.
# generate with: repel db encryption generate-key   (or: openssl rand -hex 32)
ENCRYPTION_KEY=

ANTHROPIC_API_KEY=

BLOB_STORAGE_ROOT=./data/blobs

# Google OAuth client for `repel accounts add gmail` (Google Cloud Console).
REPEL_GMAIL_CLIENT_ID=
REPEL_GMAIL_CLIENT_SECRET=
