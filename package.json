{
  "name": "repel",
  "private": true,
  "workspaces": [
    "packages/shared/*",
    "packages/backend/apps/*",
    "packages/backend/libs/*",
    "packages/frontend/apps/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "clean": "tsc --build --clean && find . -name 'tsconfig.tsbuildinfo' -not -path '*/node_modules/*' -delete && find . -type d -name dist -not -path '*/node_modules/*' -prune -exec rm -rf {} +",
    "cli": "cd packages/backend/apps/cli && bun run cli",
    "cli:debug": "cd packages/backend/apps/cli && bun run cli:debug",
    "dev:docker": "docker compose --profile dev up -d",
    "dev:docker:down": "docker compose --profile dev down",
    "dev:watch": "nx watch --all -- nx run-many -t sync build test --projects=$NX_PROJECT_NAME --output-style=stream",
    "dev:web": "cd packages/frontend/apps/web && bun run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graph": "nx graph",
    "lint": "nx run-many -t lint",
    "prepare": "husky",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t build"
  },
  "lint-staged": {
    "*.{ts,tsx,md,json,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nx/eslint": "23.0.0",
    "@nx/eslint-plugin": "23.0.0",
    "@nx/js": "23.0.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@typescript-eslint/parser": "^8.60.1",
    "bun-types": "^1.3.13",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^3.1.0",
    "lint-staged": "^17.0.2",
    "nx": "23.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5.5"
  },
  "packageManager": "bun@1.3.14"
}
