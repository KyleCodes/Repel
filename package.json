{
  "name": "repel",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc --build && bun --filter='@repel/web' run build",
    "clean": "tsc --build --clean && find . -name 'tsconfig.tsbuildinfo' -not -path '*/node_modules/*' -delete && find . -type d -name dist -not -path '*/node_modules/*' -prune -exec rm -rf {} +",
    "dev:docker": "docker compose --profile dev up -d",
    "dev:docker:down": "docker compose --profile dev down",
    "dev:server": "cd apps/server && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "bun test",
    "typecheck": "bun run clean && tsc --build"
  },
  "lint-staged": {
    "*.{ts,tsx,md,json,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "bun-types": "^1.3.13",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "prettier": "^3.8.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5.5"
  }
}
