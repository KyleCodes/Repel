{
  "name": "repel",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "cd apps/server && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "cli": "bun --filter='@repel/server' run cli --",
    "build": "bun run build --filter='*'",
    "typecheck": "tsc --build",
    "test": "bun test"
  },
  "devDependencies": {
    "typescript": "^5.5"
  }
}
