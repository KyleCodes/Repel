{
  "name": "@repel/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "cli": "bun --env-file=.env.development --env-file=.env.local run src/cli/index.ts",
    "cli:debug": "bun run bin/cli-debug.ts",
    "dev": "bun --env-file=.env.development --env-file=.env.local run --watch src/main.ts",
    "start": "bun --env-file=.env.development --env-file=.env.local run src/main.ts",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@repel/shared": "workspace:*",
    "express": "^4.19.2",
    "kysely": "^0.27.3",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.6",
    "commander": "^12.1.0",
    "kysely-codegen": "^0.20.0",
    "node-pg-migrate": "^7.7.0"
  }
}
