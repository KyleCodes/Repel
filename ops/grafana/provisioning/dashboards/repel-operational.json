{
  "uid": "repel-operational",
  "title": "Repel Operational",
  "tags": ["repel", "operational"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "DLQ size",
      "description": "Jobs in the dead-letter state (job_queue.status='dead').",
      "datasource": { "type": "postgres", "uid": "repel-postgres" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "repel-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM job_queue WHERE status = 'dead';"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active syncs",
      "description": "Sync jobs currently being processed (job_queue topic='sync', status='processing').",
      "datasource": { "type": "postgres", "uid": "repel-postgres" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "repel-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM job_queue WHERE status = 'processing' AND topic = 'sync';"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Oldest pending job age",
      "description": "Age of the oldest pending job (now() - min(created_at)).",
      "datasource": { "type": "postgres", "uid": "repel-postgres" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "red", "value": 3600 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "repel-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(EXTRACT(EPOCH FROM (now() - min(created_at))), 0) AS value FROM job_queue WHERE status = 'pending';"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Messages processed",
      "description": "Total rows in the message table.",
      "datasource": { "type": "postgres", "uid": "repel-postgres" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "repel-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM message;"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total users",
      "datasource": { "type": "postgres", "uid": "repel-postgres" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "repel-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM \"user\";"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Total orgs",
      "datasource": { "type": "postgres", "uid": "repel-postgres" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "repel-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM org;"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Active provider accounts",
      "datasource": { "type": "postgres", "uid": "repel-postgres" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "repel-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM provider_account WHERE is_active = true;"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Queue depth by topic",
      "description": "Pending and processing counts grouped by topic.",
      "datasource": { "type": "postgres", "uid": "repel-postgres" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "repel-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT topic, count(*) FILTER (WHERE status = 'pending') AS pending, count(*) FILTER (WHERE status = 'processing') AS processing FROM job_queue WHERE status IN ('pending', 'processing') GROUP BY topic ORDER BY topic;"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Jobs enqueued over time",
      "description": "Jobs created per 5-minute bucket, by topic.",
      "datasource": { "type": "postgres", "uid": "repel-postgres" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "stacking": { "mode": "normal" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "repel-postgres" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(created_at, '5m') AS time, topic, count(*) AS enqueued FROM job_queue WHERE $__timeFilter(created_at) GROUP BY 1, topic ORDER BY 1;"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Processing rate (completions)",
      "description": "Jobs completed per 5-minute bucket.",
      "datasource": { "type": "postgres", "uid": "repel-postgres" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "repel-postgres" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(completed_at, '5m') AS time, count(*) AS completed FROM job_queue WHERE status = 'completed' AND completed_at IS NOT NULL AND $__timeFilter(completed_at) GROUP BY 1 ORDER BY 1;"
        }
      ]
    }
  ]
}
